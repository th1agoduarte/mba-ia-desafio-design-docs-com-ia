# Configuração das ferramentas de IA do processo (tools/ia.py), NÃO da aplicação.
# O .env.example da raiz pertence ao OMS (Node/Prisma) e não é alterado: o enunciado proíbe
# mexer nas configurações da aplicação. Por isso estas variáveis ficam em tools/.env.
# `make env` cria tools/.env a partir deste arquivo e preenche os valores vazios com o .env raiz
# do workspace (../.env), sem sobrescrever nada e sem imprimir segredos.

# Provider padrão do LLM usado nas etapas de extração e revisão. Lido por tools/ia.py.
# Valores: google | openai | anthropic | aws | gateway. `make ... PROVIDER=x` sobrescreve.
LLM_PROVIDER=google

# --- Presets por provider. tools/ia.py escolhe <PROVIDER>_LLM_MODEL para a extração (inventário)
# --- e <PROVIDER>_EVAL_MODEL para a revisão crítica (modelo um pouco mais forte, papel de juiz).
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_EVAL_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5-mini
OPENAI_EVAL_MODEL=gpt-5

ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-haiku-5-5
ANTHROPIC_EVAL_MODEL=claude-sonnet-5-5

# AWS Bedrock: credenciais padrão da AWS (variáveis abaixo ou ~/.aws). Model ids do Bedrock.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_LLM_MODEL=
AWS_EVAL_MODEL=

# --- Gateway LiteLLM opcional (gateway/docker-compose.yml): PROVIDER=gateway manda as chamadas
# --- para ele (API OpenAI-compatível), com o modelo prefixado: gemini/<GOOGLE_*_MODEL>.
# Chave do gateway; gerada aleatoriamente por `make env` se vazia. Lida pelo gateway e por tools/ia.py.
LITELLM_MASTER_KEY=
# Porta local do gateway.
GATEWAY_PORT=4000
